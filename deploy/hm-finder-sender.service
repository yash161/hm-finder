[Unit]
Description=Drain HM Finder scheduled Gmail queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=yash
EnvironmentFile=/home/yash/hm-finder-sender/sender.env
ExecStart=/usr/bin/python3 /home/yash/hm-finder-sender/gmail_queue_worker.py
WorkingDirectory=/home/yash/hm-finder-sender
Nice=10

[Install]
WantedBy=multi-user.target
